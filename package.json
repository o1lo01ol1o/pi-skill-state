{
  "name": "pi-skill-state",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, schema-validated execution state for procedural pi skills.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test",
    "verify:live-session": "tsx scripts/verify-live-session.mjs"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "state-management"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^24.0.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  }
}
